<block wx:if="{{viewInfo}}"><view class="content"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-left1" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><view class="topbar"><block wx:if="{{!is_video}}"><view data-event-opts="{{[['tap',[['changeVideo']]]]}}" class="myVideoBar" bindtap="__e"><text class="icon icon-ziyuan3"></text><image class="myImage" mode="widthFix" src="{{viewInfo.thumb}}"></image></view></block><block wx:else><video class="myVideo" id="myVideo" src="{{viewInfo.link}}" poster="{{viewInfo.thumb}}" controls="{{true}}" data-event-opts="{{[['error',[['videoError',['$event']]]],['timeupdate',[['playOntime',['$event']]]]]}}" binderror="__e" bindtimeupdate="__e"><cover-view data-event-opts="{{[['tap',[['showSwitchRate',['$event']]]]]}}" class="video-control" bindtap="__e">{{''+currentRate+'x'}}</cover-view><cover-view class="{{['multi-list','rate',(rateShow)?'active':'']}}"><block wx:for="{{['0.5','0.8','1.0','1.25','1.5','2.0']}}" wx:for-item="item" wx:for-index="index" wx:key="index"><cover-view class="{{['multi-item','rate',(item==currentRate)?'active':'']}}" data-rate="{{item}}" data-event-opts="{{[['tap',[['switchRate',['$event']]]]]}}" bindtap="__e">{{''+item+''}}</cover-view></block></cover-view></video></block></view><view class="mainbar"><view class="video-info"><view class="titles"><text class="level">{{viewInfo.level_name}}</text><text class="name">{{viewInfo.title}}</text></view><view class="other"><view class="price"><view class="now-tags"><block wx:if="{{viewInfo.price==0}}"><text class="free">{{$root.m0}}</text></block><block wx:if="{{viewInfo.price>0&&viewInfo.is_vip>-1}}"><text class="svip">{{$root.m1}}</text></block><block wx:if="{{viewInfo.price>0&&viewInfo.is_vip==-1}}"><text class="now">{{$root.m2}}</text></block></view><text class="cost">{{$root.m3}}</text></view><view class="join"><text class="nums">{{viewInfo.sales+"人学习"}}</text></view></view></view><view class="video-list"></view><block wx:if="{{$root.g0>0}}"><view class="wechat-group"><block wx:for="{{viewInfo.group}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="group-item"><image class="thumb" src="{{item.groups.thumb?item.groups.thumb:'/static/img/logo.png'}}"></image><view class="info"><view class="name">{{item.groups.name}}</view><view class="remark">{{''+item.groups.desc+''}}</view></view><view class="join"><text data-event-opts="{{[['tap',[['showQrcode',['$0'],[[['viewInfo.group','',index]]]]]]]}}" class="join-in" bindtap="__e">进群</text></view></view></block></view></block><block wx:if="{{$root.g1>0}}"><view class="wechat-group"><block wx:for="{{viewInfo.jump}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="group-item"><image class="thumb" src="{{item.jumps.thumb?item.jumps.thumb:'/static/img/logo.png'}}"></image><view class="info"><view class="name">{{item.jumps.name}}</view><view class="remark">{{''+item.jumps.desc+''}}</view></view><view class="join"><text data-event-opts="{{[['tap',[['jumpLink',['$0'],[[['viewInfo.jump','',index]]]]]]]}}" class="join-in" bindtap="__e">进入</text></view></view></block></view></block><view class="title"><text class="icon icon-zuanshi"></text><text class="name">详情</text></view><view class="detail"><mp-html vue-id="66d69f1a-1" content="{{viewInfo.content}}" bind:__l="__l"></mp-html></view><block wx:if="{{advInfo}}"><view class="ad-view"><ad unit-id="{{advInfo.advid}}" ad-intervals="100"></ad></view></block></view><navbar-side vue-id="66d69f1a-2" vdata="{{viewInfo}}" bind:__l="__l"></navbar-side><uni-popup class="vue-ref" vue-id="66d69f1a-3" type="center" maskClick="{{true}}" data-ref="qrPopup" bind:__l="__l" vue-slots="{{['default']}}"><block wx:if="{{qunInfo}}"><view class="qrcodeBar"><view class="title">{{qunInfo.groups.name+''}}<text data-event-opts="{{[['tap',[['closeQrcode']]]]}}" class="icon icon-close" bindtap="__e"></text></view><view class="desc">{{qunInfo.groups.desc}}</view><view class="qrcode"><image class="qrimg" mode="widthFix" src="{{qunInfo.groups.url}}" show-menu-by-longpress="true"></image></view><view class="remark"><button data-event-opts="{{[['tap',[['saveQrcode',['$0'],['qunInfo.groups.url']]]]]}}" class="btn-qrcode" bindtap="__e">保存社群码</button></view></view></block></uni-popup></view></block>