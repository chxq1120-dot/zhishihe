<block wx:if="{{viewInfo}}"><view class="content"><go-top vue-id="fbb6b900-1" is-top="{{isTop}}" bind:__l="__l"></go-top><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-left1" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><view class="topbar"><view class="thumb-info"><image class="thumb" mode="widthFix" src="{{viewInfo.thumb}}"></image></view><view class="infos"><view class="title"><text class="level">{{viewInfo.level_name}}</text><text class="name">{{viewInfo.title}}</text></view><view class="others"><view class="price"><view class="now-tags"><block wx:if="{{viewInfo.price==0}}"><text class="free">{{$root.m0}}</text></block><block wx:if="{{viewInfo.price>0&&viewInfo.is_vip>-1}}"><text class="svip">{{$root.m1}}</text></block><block wx:if="{{viewInfo.price>0&&viewInfo.is_vip==-1}}"><text class="now">{{$root.m2}}</text></block></view><text class="cost">{{$root.m3}}</text></view><view class="sales"><text class="num">{{viewInfo.sales+sale_unit_text}}</text></view></view></view></view><view class="mainbar"><block wx:if="{{$root.g0>0}}"><view class="wechat-group"><block wx:for="{{viewInfo.group}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="group-item"><image class="thumb" src="{{item.groups.thumb?item.groups.thumb:'/static/img/logo.png'}}"></image><view class="info"><view class="name">{{item.groups.name}}</view><view class="remark">{{''+item.groups.desc+''}}</view></view><view class="join"><text data-event-opts="{{[['tap',[['showQrcode',['$0'],[[['viewInfo.group','',index]]]]]]]}}" class="join-in" bindtap="__e">进群</text></view></view></block></view></block><block wx:if="{{$root.g1>0}}"><view class="wechat-group"><block wx:for="{{viewInfo.jump}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="group-item"><image class="thumb" src="{{item.jumps.thumb?item.jumps.thumb:'/static/img/logo.png'}}"></image><view class="info"><view class="name">{{item.jumps.name}}</view><view class="remark">{{''+item.jumps.desc+''}}</view></view><view class="join"><text data-event-opts="{{[['tap',[['jumpLink',['$0'],[[['viewInfo.jump','',index]]]]]]]}}" class="join-in" bindtap="__e">进入</text></view></view></block></view></block><block wx:if="{{viewInfo.type==1}}"><view class="resbox"><view data-event-opts="{{[['tap',[['showUnlock']]]]}}" class="lock" bindtap="__e"><block wx:if="{{viewInfo.is_auth==0}}"><view class="lock-fail"><text class="icon icon-fail"></text><block wx:if="{{platform=='ios'&&ios_close=='1'}}"><text>无法查看资源内容，请完成任务或兑换！</text></block><block wx:else><text>无法查看资源内容，请完成任务或购买！</text></block></view></block><block wx:else><view class="lock-success"><text class="icon icon-cor-success"></text><text>已获查看权限，点击查看资源内容！</text></view></block></view></view></block><view class="title"><text class="icon icon-zuanshi"></text><text class="name">资源介绍</text></view><view class="detail"><mp-html vue-id="fbb6b900-2" content="{{viewInfo.content}}" bind:__l="__l"></mp-html></view><block wx:if="{{advInfo}}"><view class="ad-view"><ad unit-id="{{advInfo.advid}}" ad-intervals="100"></ad></view></block></view><navbar-side vue-id="fbb6b900-3" vdata="{{viewInfo}}" bind:__l="__l"></navbar-side><uni-popup class="vue-ref" vue-id="fbb6b900-4" type="center" maskClick="{{true}}" data-ref="qrPopup" bind:__l="__l" vue-slots="{{['default']}}"><block wx:if="{{qunInfo}}"><view class="qrcodeBar"><view class="title">{{qunInfo.groups.name+''}}<text data-event-opts="{{[['tap',[['closeQrcode']]]]}}" class="icon icon-close" bindtap="__e"></text></view><view class="desc">{{qunInfo.groups.desc}}</view><view class="qrcode"><image class="qrimg" mode="widthFix" src="{{qunInfo.groups.url}}" show-menu-by-longpress="true"></image></view><view class="remark"><button data-event-opts="{{[['tap',[['saveQrcode',['$0'],['qunInfo.groups.url']]]]]}}" class="btn-qrcode" bindtap="__e">保存社群码</button></view></view></block></uni-popup><uni-popup class="vue-ref" vue-id="fbb6b900-5" type="center" maskClick="{{true}}" data-ref="unlockPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="showBar"><view class="title">查看资源<text data-event-opts="{{[['tap',[['cancelShow']]]]}}" class="icon icon-close" bindtap="__e"></text></view><block wx:if="{{viewInfo.is_auth==1}}"><view class="showDesc"><view class="links"><text class="links-inp" user-select="{{true}}" selectable="{{true}}">{{''+viewInfo.link+''}}<block wx:if="{{viewInfo.ext_code}}"><text>{{"提取码："+viewInfo.ext_code}}</text></block></text><text class="tips">可长按资源链接进行复制</text></view></view></block><view class="showFoot"><block wx:if="{{is_opendisk=='1'}}"><view data-event-opts="{{[['tap',[['copyLinks']]]]}}" class="copyLink" bindtap="__e">复制链接</view><view data-event-opts="{{[['tap',[['openDisk']]]]}}" class="copyCode" bindtap="__e">打开网盘</view></block><block wx:else><view data-event-opts="{{[['tap',[['cancelShow']]]]}}" class="copyLink" bindtap="__e">关闭</view><view data-event-opts="{{[['tap',[['copyLinks']]]]}}" class="copyCode" bindtap="__e">复制链接</view></block></view></view></uni-popup></view></block>