.placeholder{color:#c9c9c9;font-size:28rpx}.red{color:#ff4949}.blue{color:#38a9ff}.green{color:#19be6b}.gray{color:#c9c9c9}.orange{color:#ff6e3e}.yellow{color:#fea700}.status_bar{height:25px;width:100%}.nodata{display:flex;justify-content:center;align-items:center;position:relative;padding-top:280rpx}.nodata .msg{color:#c9c9c9;background-color:#f8f8f8;position:relative;padding:0 15rpx}.nodata::before{position:absolute;content:"";height:2rpx;background-color:#dfdfdf;left:30%;right:30%;bottom:5%}.pai-video{position:fixed;right:10rpx;top:75%;z-index:999999;width:180rpx;background:none;display:flex;align-items:center;justify-content:center;flex-direction:column;line-height:normal}.pai-video .icon-video{color:#000;font-size:36rpx;display:block;text-align:center;width:76rpx;height:76rpx;line-height:76rpx;background-color:#fec200;border-radius:50%;border:#fff 4rpx solid;box-shadow:0 6rpx 8rpx 0 rgba(0,0,0,.4)}.pai-video .name{color:#000;line-height:normal;font-size:24rpx;background-color:#fec200;padding:6rpx 20rpx;border-radius:6rpx;border:#fff 2rpx solid;box-shadow:0 4rpx 6rpx 0 rgba(0,0,0,.2)}uni-toast{z-index:999999!important}button::after{border:0!important}.content{position:relative}.holder{position:absolute;height:500rpx;left:0;right:0;z-index:1;border-radius:0 0 40rpx 40rpx}.popupBar{background-color:#fff;border-radius:20rpx;width:600rpx;overflow:hidden}.popupBar .title{font-size:32rpx;padding:30rpx 20px;border-bottom:#eee 2rpx solid;position:relative}.popupBar .desc{font-size:28rpx;padding:30rpx 40rpx;text-indent:2em;line-height:200%;color:#4c4c4c}.popupBar .desc .term{color:#38a9ff}.popupBar .popup-btn{display:flex;align-items:center;justify-content:space-between;border-top:#eee 2rpx solid}.popupBar .popup-btn button{background-color:#fff;height:100rpx;line-height:100rpx;flex:1;font-size:32rpx;border-radius:0;padding:0}.popupBar .popup-btn button:active{background-color:#f8f8f8}.popupBar .popup-btn .btn-refuse{color:#6c6c6c}.popupBar .popup-btn .btn-agree{color:#3