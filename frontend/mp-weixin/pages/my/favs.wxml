<view class="content"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-return" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><view class="sortbar"><uv-tabs vue-id="bc013c18-1" list="{{sortlist}}" lineWidth="15" lineColor="{{subcolor}}" activeStyle="{{({color:'#4c4c4c',fontWeight:'bold',transform:'scale(1.05)'})}}" data-event-opts="{{[['^click',[['changeTab']]]]}}" bind:click="__e" bind:__l="__l"></uv-tabs></view><view class="newest"><block wx:if="{{$root.g0}}"><view><scroll-view class="newest-grid" scroll-y="{{true}}" scroll-left="{{scrollLeft}}"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToShow',['$0','$1'],[[['newList','',index,'id']],[['newList','',index,'type']]]]]]]}}" class="newest-item" bindtap="__e"><view class="{{[item.$orig.type==2?'thumb-info inplay':'thumb-info']}}"><image class="thumb" mode="aspectFit" src="{{item.$orig.thumb}}" lazy-load="{{true}}"></image></view><view class="newest-info"><view class="title">{{item.$orig.title}}</view><view class="price"><view class="now-tags"><block wx:if="{{item.$orig.price==0}}"><text class="free">{{item.m0}}</text></block><block wx:if="{{item.$orig.price>0&&item.$orig.is_vip>-1}}"><text class="svip">{{item.m1}}</text></block><block wx:if="{{item.$orig.price>0&&item.$orig.is_vip==-1}}"><text class="now">{{item.m2}}</text></block></view><text class="cost">{{item.m3}}</text></view><view class="info"><text class="view">{{item.$orig.level_name}}</text><text class="join">{{item.$orig.sales+"人已购"}}</text></view></view></view></block></scroll-view><block wx:if="{{loadmore==true}}"><uni-load-more vue-id="bc013c18-2" color="#c9c9c9" status="{{status}}" bind:__l="__l"></uni-load-more></block></view></block><block wx:else><view class="record"><view class="icon icon-zanwushuju _i"></view><text>-  暂无数据  -</text></view></block><block wx:if="{{advInfo}}"><view class="ad-view"><ad unit-id="{{advInfo.advid}}" ad-intervals="100"></ad></view></block></view></view>