<block wx:if="{{config}}"><view class="content"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-return" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><uv-tabs vue-id="5bc5cd5e-1" list="{{sortlist}}" current="{{current}}" scrollable="{{false}}" lineWidth="15" lineColor="{{subcolor}}" activeStyle="{{({color:'#4c4c4c',fontWeight:'bold',transform:'scale(1.05)'})}}" data-event-opts="{{[['^click',[['changeTab']]]]}}" bind:click="__e" bind:__l="__l"></uv-tabs><view class="newest"><block wx:if="{{current==0}}"><view class="newest-grid"><view class="newest-tags"><view data-event-opts="{{[['tap',[['CurrentTab',[0]]]]]}}" class="{{[tabCurrent==0?'name on':'name']}}" bindtap="__e">全部</view><view data-event-opts="{{[['tap',[['CurrentTab',[1]]]]]}}" class="{{[tabCurrent==1?'name on':'name']}}" bindtap="__e">{{"待"+tagsName}}</view><view data-event-opts="{{[['tap',[['CurrentTab',[2]]]]]}}" class="{{[tabCurrent==2?'name on':'name']}}" bindtap="__e">{{"已"+tagsName}}</view></view><block wx:if="{{$root.g0>0}}"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="newest-item"><view data-event-opts="{{[['tap',[['goToOrder',['$0'],[[['newList','',index,'id']]]]]]]}}" class="newest-head" bindtap="__e"><view class="ordno">{{item.$orig.ctime}}</view><view class="status"><block wx:if="{{item.$orig.status==0}}"><text class="red">{{"待"+tagsName}}</text></block><block wx:else><block wx:if="{{item.$orig.status==2}}"><text class="gray">已取消</text></block><block wx:else><text class="green">{{"已"+tagsName}}</text></block></block></view></view><view class="newest-info"><view data-event-opts="{{[['tap',[['goToOrder',['$0'],[[['newList','',index,'id']]]]]]]}}" class="goods" bindtap="__e"><view class="goods-img"><image class="thumb" src="{{item.$orig.thumb}}" mode="widthFix"></image></view><view class="title">{{item.$orig.title}}</view><view class="goods-price"><view class="price">{{item.m0}}</view><view class="nums">共1件</view></view></view><view class="info"><view class="view"><text class="buys">{{''+item.$orig.sales+sale_unit_text+''}}</text></view><view data-event-opts="{{[['tap',[['goToShow',['$0','$1'],[[['newList','',index,'rid']],[['newList','',index,'type']]]]]]]}}" class="pay-btn" bindtap="__e"><text class="views">去查看</text></view></view></view></view></block><block wx:if="{{loadmore==true}}"><uni-load-more vue-id="5bc5cd5e-2" color="#c9c9c9" status="{{status}}" bind:__l="__l"></uni-load-more></block></block><block wx:else><view class="record"><view class="icon icon-file _i"></view><text>-  暂无数据  -</text></view></block></view></block><block wx:if="{{current==1}}"><view class="newest-grid"><block wx:if="{{$root.g1>0}}"><block wx:for="{{$root.l1}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{item.g2>0}}"><view class="newest-item"><view class="newest-head"><view class="ordno">{{''+item.$orig.ctime+''}}</view><view class="status"><text class="green">已获取</text></view></view><view class="newest-info"><view class="goods"><view class="goods-img"><image class="thumb" src="{{item.$orig.thumb}}" mode="widthFix"></image></view><view class="title">{{item.$orig.title}}</view><view class="goods-price"><view class="price">{{item.m1}}</view><view class="nums">共1件</view></view></view><view class="info"><view class="view"><text class="buys">{{''+item.$orig.sales+sale_unit_text+''}}</text></view><view class="pay-btn"><text data-event-opts="{{[['tap',[['goToShow',['$0','$1'],[[['taskList','',index,'rid']],[['taskList','',index,'type']]]]]]]}}" class="views" bindtap="__e">去查看</text></view></view></view></view></block></block><block wx:if="{{loadmore==true}}"><uni-load-more vue-id="5bc5cd5e-3" color="#c9c9c9" status="{{status}}" bind:__l="__l"></uni-load-more></block></block><block wx:else><view class="record"><view class="icon icon-zanwushuju _i"></view><text>-  暂无数据  -</text></view></block></view></block></view></view></block>