<view class="content"><view class="{{[showIcon?'plan plans':'plan']}}"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-left1" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><view class="item"><view class="label">用户头像</view><view class="form"><button class="avatar" open-type="chooseAvatar" data-event-opts="{{[['chooseavatar',[['onChooseAvatar',['$event']]]]]}}" bindchooseavatar="__e"><image class="avatar" src="{{user.avatar}}"></image></button></view></view><view class="item"><view class="label">用户昵称</view><view class="form"><input type="nickname" placeholder="请输入您的昵称" maxlength="20" placeholder-class="placeholder" data-event-opts="{{[['input',[['__set_model',['$0','nickname','$event',[]],['user']]]]]}}" value="{{user.nickname}}" bindinput="__e"/></view></view><block wx:if="{{is_show_bind}}"><view class="item"><view class="label">手机号码</view><view class="form"><text class="mobile">{{$root.g0}}</text><block wx:if="{{user.mobile}}"><view data-event-opts="{{[['tap',[['goBindMobile']]]]}}" class="bind" bindtap="__e"><text class="bindText">换绑</text><text class="icon icon-right"></text></view></block><block wx:else><view data-event-opts="{{[['tap',[['goBindMobile']]]]}}" class="bind" bindtap="__e"><text class="bindText">绑定</text><text class="icon icon-right"></text></view></block></view></view></block></view><view class="remark"><text class="desc">昵称长度2~10个字符</text></view><button data-event-opts="{{[['tap',[['saveInfo']]]]}}" class="save-plan" bindtap="__e">保存</button></view>