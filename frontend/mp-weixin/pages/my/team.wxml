<block wx:if="{{config}}"><view class="content"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-left1" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><view class="{{[showIcon?'sortbar sortbar1':'sortbar']}}" style="{{('background-image:linear-gradient(to bottom,'+maincolor+','+subcolor+');color:'+textcolor+';')}}"><view class="cardbar"><view class="total"><view class="rows"><text class="name">账户余额(元)</text><text class="nums">{{income.balance}}</text></view><view class="rows"><text class="name">今日收入(元)</text><text class="nums">{{income.today}}</text></view></view><view class="other"><view class="today"><text class="name">昨日收入(元)</text><text class="nums">{{income.yesday}}</text></view><view class="month"><text class="name">本月收入(元)</text><text class="nums">{{income.month}}</text></view><view class="month"><text class="name">累计收入(元)</text><text class="nums">{{income.total}}</text></view></view></view><view class="ctr-btn"><button class="invite" style="{{'color:'+(subcolor)+';'}}" open-type="share"><text class="icon icon-user2"></text><text class="name">邀请好友</text></button><view data-event-opts="{{[['tap',[['onCreatePoster',['$event']]]]]}}" class="invite" style="{{'color:'+(subcolor)+';'}}" bindtap="__e"><text class="icon icon-icon_share"></text><text class="name">海报邀请</text></view></view></view><view class="newest"><uv-tabs vue-id="07bb9122-1" list="{{sortlist}}" current="{{current}}" scrollable="{{false}}" lineWidth="15" lineColor="{{subcolor}}" activeStyle="{{({color:'#4c4c4c',fontWeight:'bold',transform:'scale(1.05)'})}}" data-event-opts="{{[['^click',[['onTabChange']]]]}}" bind:click="__e" bind:__l="__l"></uv-tabs><block wx:if="{{current==0}}"><view class="newest-user"><block wx:if="{{$root.g0}}"><block wx:for="{{userList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="newest-item"><view class="thumb-info"><image class="thumb" src="{{item.avatar}}"></image></view><view class="newest-info"><view class="nickname">{{item.nickname}}</view><view class="ctime">{{item.ctime}}</view></view><view class="levelname"><text>{{item.level_name}}</text></view></view></block><block wx:if="{{loadmore==true}}"><uni-load-more vue-id="07bb9122-2" color="#c9c9c9" status="{{status}}" bind:__l="__l"></uni-load-more></block></block><block wx:else><view class="record"><view class="icon icon-zanwushuju _i"></view><text>-  暂无数据  -</text></view></block></view></block><block wx:if="{{current==1}}"><view class="income-list"><block wx:if="{{$root.g1}}"><block wx:for="{{incomeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goToPath',['$0'],[[['incomeList','',index]]]]]]]}}" class="income-item" bindtap="__e"><view class="thumb-info"><image class="thumb" src="{{item.avatar}}"></image></view><view class="info"><view class="nickname">{{''+item.nickname+''}}</view><view class="ordername">{{''+item.order_name+''}}</view></view><view class="other"><view class="money"><block wx:if="{{item.mode==1}}"><text class="add">{{"+"+item.money}}</text></block><block wx:else><text class="dec">{{"-"+item.money}}</text></block></view><view class="ctime">{{''+item.utime+''}}</view></view></view></block><block wx:if="{{loadmore==true}}"><uni-load-more vue-id="07bb9122-3" color="#c9c9c9" status="{{status}}" bind:__l="__l"></uni-load-more></block></block><block wx:else><view class="record"><view class="icon icon-zanwushuju _i"></view><text>-  暂无数据  -</text></view></block></view></block><block wx:if="{{advInfo}}"><view class="ad-view"><ad unit-id="{{advInfo.advid}}" ad-intervals="100"></ad></view></block></view><uni-popup class="vue-ref" vue-id="07bb9122-4" type="center" maskClick="{{true}}" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><view class="flex_column"><view data-event-opts="{{[['tap',[['hideQr']]]]}}" class="onclose" bindtap="__e"><text class="icon icon-close"></text></view><view class="backgroundColor-white"><image class="posterImage" src="{{posterImage||''}}" mode="widthFix"></image></view><view class="flex_row marginTop2vh"><button class="btn-img" type="primary" size="mini" data-event-opts="{{[['tap',[['saveQrcode',['$0'],['posterImage']]]]]}}" catchtap="__e">保存海报</button><button class="btn-img" type="primary" size="mini" open-type="share">分享好友</button></view></view></uni-popup></view></block>