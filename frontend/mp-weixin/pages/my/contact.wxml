<view class="content"><view class="flex"><block wx:if="{{showIcon}}"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-left1" bindtap="__e"></text></block><view class="title">联系方式</view></view><view class="qrcode"><image class="imgs" src="{{config.web.qrcode}}" show-menu-by-longpress="true"></image></view><view class="list"><view class="list-item"><text class="name">联系人：</text><text class="val">{{config.web.contact}}</text></view><view class="list-item"><view class="name">客服微信：</view><view class="val"><text class="vals">{{config.web.wechat}}</text><text data-event-opts="{{[['tap',[['copyText',['$0'],['config.web.wechat']]]]]}}" class="btn-copy" bindtap="__e">复制</text></view></view><view class="list-item"><view class="name">客服电话：</view><view class="val"><text class="vals">{{config.web.phone}}</text><text data-event-opts="{{[['tap',[['copyText',['$0'],['config.web.phone']]]]]}}" class="btn-copy" bindtap="__e">复制</text></view></view></view><view class="bom-bar"><button class="btn-contact" open-type="contact">平台客服（投诉）</button></view></view>