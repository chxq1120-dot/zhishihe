<block wx:if="{{config}}"><view class="content"><block wx:if="{{showIcon}}"><view class="icon_home"><text data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="icon icon-return" bindtap="__e"></text><text class="Before"></text><text data-event-opts="{{[['tap',[['goHome',['$event']]]]]}}" class="icon icon-home2" bindtap="__e"></text></view></block><block wx:if="{{viewInfo}}"><view class="goods"><view class="ctime">{{viewInfo.ctime}}</view><view data-event-opts="{{[['tap',[['goToShow',['$0','$1'],['viewInfo.rid','viewInfo.type']]]]]}}" class="items" bindtap="__e"><view class="items-thumb"><image class="thumb" src="{{viewInfo.thumb}}" mode="widthFix"></image></view><view class="items-info"><view class="items-head"><view class="title">{{viewInfo.title}}</view><view class="items-price"><view class="price">{{$root.m0}}</view><view class="nums">共1件</view></view></view><view class="other"><text class="level">{{viewInfo.level_name}}</text><text class="sales">{{viewInfo.sales+sale_unit_text}}</text></view></view></view><button data-event-opts="{{[['tap',[['onKefu']]]]}}" class="kefu" bindtap="__e"><text class="icon icon-kefu"></text><text class="name">客服</text></button></view></block><block wx:if="{{viewInfo}}"><view class="total"><view class="items"><text class="label">总价</text><text class="value">{{$root.m1}}</text></view><view class="items"><text class="label">实付款</text><text class="value">{{"¥"+viewInfo.money}}</text></view></view></block><view class="order"><view class="items"><text class="label">订单编号</text><text class="value">{{viewInfo.ordno}}</text></view><view class="items"><text class="label">下单时间</text><text class="value">{{viewInfo.ctime}}</text></view><view class="items"><text class="label">支付状态</text><text class="value">{{viewInfo.pay_status}}</text></view><view class="items"><text class="label">支付方式</text><text class="value">{{viewInfo.pay_type}}</text></view></view><uni-popup class="vue-ref" vue-id="f8ed20de-1" type="center" maskClick="{{true}}" data-ref="kefuPopup" bind:__l="__l" vue-slots="{{['default']}}"><block wx:if="{{config}}"><view class="qrcodeBar"><view class="title">联系客服<text data-event-opts="{{[['tap',[['closeKefu']]]]}}" class="icon icon-close" bindtap="__e"></text></view><view class="qrcode"><image class="qrimg" mode="widthFix" src="{{config.web.qrcode}}" show-menu-by-longpress="true"></image></view><view class="desc"><view class="desc-txt">{{"客服微信："+config.web.wechat}}</view><view data-event-opts="{{[['tap',[['copyWechat']]]]}}" class="desc-copy" bindtap="__e">复制</view></view><view class="remark"><button data-event-opts="{{[['tap',[['saveQrcode',['$0'],['config.web.qrcode']]]]]}}" class="btn-qrcode" bindtap="__e">保存</button></view></view></block></uni-popup></view></block>