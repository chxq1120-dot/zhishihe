<view class="sort-bar"><block wx:if="{{wdata.params.is_title=='true'}}"><view class="title"><text class="icon icon-new"></text><text class="name">{{wdata.params.title}}</text><block wx:if="{{wdata.params.lookMore=='true'}}"><view data-event-opts="{{[['tap',[['goMore']]]]}}" class="more" bindtap="__e"><text class="more-text">更多</text><text class="icon icon-right"></text></view></block></view></block><view class="sort-view"><block wx:if="{{wdata.params.type=='auto'}}"><block wx:for="{{sortlist}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{sortlist}}"><view data-event-opts="{{[['tap',[['goSort',['$0'],[[['sortlist','',index,'id']]]]]]]}}" class="sort-item" bindtap="__e"><image class="{{['icon-head',wdata.params.style]}}" src="{{item.thumb}}"></image><view class="name">{{item.name}}</view></view></block></block></block><block wx:if="{{wdata.params.type=='choose'}}"><block wx:for="{{wdata.params.list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{wdata.params.list}}"><view data-event-opts="{{[['tap',[['goSort',['$0'],[[['wdata.params.list','',index,'id']]]]]]]}}" class="sort-item" bindtap="__e"><image class="{{['icon-head',wdata.params.style]}}" src="{{item.thumb}}"></image><view class="name">{{item.name}}</view></view></block></block></block></view></view>