.placeholder{color:#c9c9c9;font-size:28rpx}.red{color:#ff4949}.blue{color:#38a9ff}.green{color:#19be6b}.gray{color:#c9c9c9}.orange{color:#ff6e3e}.yellow{color:#fea700}.status_bar{height:25px;width:100%}.nodata{display:flex;justify-content:center;align-items:center;position:relative;padding-top:280rpx}.nodata .msg{color:#c9c9c9;background-color:#f8f8f8;position:relative;padding:0 15rpx}.nodata::before{position:absolute;content:"";height:2rpx;background-color:#dfdfdf;left:30%;right:30%;bottom:5%}.pai-video{position:fixed;right:10rpx;top:75%;z-index:999999;width:180rpx;background:none;display:flex;align-items:center;justify-content:center;flex-direction:column;line-height:normal}.pai-video .icon-video{color:#000;font-size:36rpx;display:block;text-align:center;width:76rpx;height:76rpx;line-height:76rpx;background-color:#fec200;border-radius:50%;border:#fff 4rpx solid;box-shadow:0 6rpx 8rpx 0 rgba(0,0,0,.4)}.pai-video .name{color:#000;line-height:normal;font-size:24rpx;background-color:#fec200;padding:6rpx 20rpx;border-radius:6rpx;border:#fff 2rpx solid;box-shadow:0 4rpx 6rpx 0 rgba(0,0,0,.2)}uni-toast{z-index:999999!important}button::after{border:0!important}.index-article{background-color:#fff;padding:10rpx 20rpx}.index-article .cell-item{display:flex;justify-content:space-between;border-bottom:#eee 2rpx solid;padding:10rpx 0}.index-article .cell-title-img{width:180rpx;height:120rpx}.index-article .cell-title-img image{width:100%;height:100%}.index-article .cell-item-bd{padding-right:0;vertical-align:top;position:relative;width:calc(100% - 200rpx)}.index-article .article-title{font-size:28rpx;color:#333;width:100%;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.index-article .article-time{font-size:24rpx;color:#c9c9c9;padding-top:10rpx}