.placeholder{color:#c9c9c9;font-size:28rpx}.red{color:#ff4949}.blue{color:#38a9ff}.green{color:#19be6b}.gray{color:#c9c9c9}.orange{color:#ff6e3e}.yellow{color:#fea700}.status_bar{height:25px;width:100%}.nodata{display:flex;justify-content:center;align-items:center;position:relative;padding-top:280rpx}.nodata .msg{color:#c9c9c9;background-color:#f8f8f8;position:relative;padding:0 15rpx}.nodata::before{position:absolute;content:"";height:2rpx;background-color:#dfdfdf;left:30%;right:30%;bottom:5%}.pai-video{position:fixed;right:10rpx;top:75%;z-index:999999;width:180rpx;background:none;display:flex;align-items:center;justify-content:center;flex-direction:column;line-height:normal}.pai-video .icon-video{color:#000;font-size:36rpx;display:block;text-align:center;width:76rpx;height:76rpx;line-height:76rpx;background-color:#fec200;border-radius:50%;border:#fff 4rpx solid;box-shadow:0 6rpx 8rpx 0 rgba(0,0,0,.4)}.pai-video .name{color:#000;line-height:normal;font-size:24rpx;background-color:#fec200;padding:6rpx 20rpx;border-radius:6rpx;border:#fff 2rpx solid;box-shadow:0 4rpx 6rpx 0 rgba(0,0,0,.2)}uni-toast{z-index:999999!important}button::after{border:0!important}.tabbar{height:110rpx;position:fixed;background-color:#fff;padding-bottom:0;padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom);bottom:0;left:0;right:0;z-index:9999;display:flex;align-items:center;box-shadow:0 -2rpx 20rpx rgba(0,0,0,.06)}.tabbar::before{content:"";position:absolute;top:0;left:0;right:0;height:1rpx;background:linear-gradient(90deg,transparent,rgba(0,0,0,.08),transparent)}.tabbar .nav-item{display:flex;flex:1;align-items:center;justify-content:center;flex-direction:column;position:relative;padding:8rpx 0;transition:all .2s ease}.tabbar .nav-item::after{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%) scaleX(0);width:48rpx;height:6rpx;border-radius:0 0 6rpx 6rpx;background:linear-gradient(135deg,#ffc037,#ff9500);transition:transform .3s cubic-bezier(.4,0,.2,1)}.tabbar .nav-item.on::after{transform:translateX(-50%) scaleX(1)}.tabbar .nav-item .thumb{width:52rpx;height:52rpx;transition:transform .25s cubic-bezier(.4,0,.2,1)}.tabbar .nav-item.on .thumb{transform:scale(1.08)}.tabbar .nav-item .name{padding-top:4rpx;font-size:20rpx;color:#999;transition:color .2s ease,font-weight .2s ease}.tabbar .nav-item.on .name{color:#ffc037;font-weight:600}
