.placeholder{color:#c9c9c9;font-size:28rpx}.red{color:#ff4949}.blue{color:#38a9ff}.green{color:#19be6b}.gray{color:#c9c9c9}.orange{color:#ff6e3e}.yellow{color:#fea700}.status_bar{height:25px;width:100%}.nodata{display:flex;justify-content:center;align-items:center;position:relative;padding-top:280rpx}.nodata .msg{color:#c9c9c9;background-color:#f8f8f8;position:relative;padding:0 15rpx}.nodata::before{position:absolute;content:"";height:2rpx;background-color:#dfdfdf;left:30%;right:30%;bottom:5%}.pai-video{position:fixed;right:10rpx;top:75%;z-index:999999;width:180rpx;background:none;display:flex;align-items:center;justify-content:center;flex-direction:column;line-height:normal}.pai-video .icon-video{color:#000;font-size:36rpx;display:block;text-align:center;width:76rpx;height:76rpx;line-height:76rpx;background-color:#fec200;border-radius:50%;border:#fff 4rpx solid;box-shadow:0 6rpx 8rpx 0 rgba(0,0,0,.4)}.pai-video .name{color:#000;line-height:normal;font-size:24rpx;background-color:#fec200;padding:6rpx 20rpx;border-radius:6rpx;border:#fff 2rpx solid;box-shadow:0 4rpx 6rpx 0 rgba(0,0,0,.2)}uni-toast{z-index:999999!important}button::after{border:0!important}.imgSlide{position:relative;height:380rpx}.imgSlide .holder{padding-top:100rpx;background-color:#ffc037;position:relative;height:100rpx;z-index:1;border-radius:0 0 40rpx 40rpx}.imgSlide .swiper{top:8%;left:2.5%;right:2.5%;margin:0 auto;height:340rpx;z-index:9;position:absolute}.imgSlide .swiper .swiper-item{height:340rpx}.imgSlide .swiper .swiper-item image{width:100%;height:340rpx;border-radius:16rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.1)}
