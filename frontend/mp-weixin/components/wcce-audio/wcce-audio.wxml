<view class="audio-bar"><view class="audio-wrap"><view class="cover-warp"><block wx:if="{{poster}}"><image class="cover-img" src="{{poster}}" mode="aspectFit"></image></block></view><view class="audio-info"><view class="audio-title">{{audioList[audioIndex].title}}</view><view class="audio-desc">{{"时长："+audioList[audioIndex].times}}</view></view></view><view class="audio-ctr"><view class="audio-sliders"><view class="audio-number">{{audioTimeUpdate}}</view><slider class="audio-slider" activeColor="{{themeColor}}" backgroundColor="#c9c9c9" block-size="14" value="{{currentDuration}}" max="{{audioDuration}}" data-event-opts="{{[['change',[['handleSlide',['$event']]]]]}}" bindchange="__e"></slider><view class="audio-number">{{totalAudioTime}}</view></view><view class="audio-btns"><view data-event-opts="{{[['tap',[['handleBack',[-15]]]]]}}" class="del-time" bindtap="__e"><text class="icon icon-goback"></text></view><view class="audio-btn"><block wx:if="{{audioIndex==0}}"><view class="audio-btn-pre"><text class="icon icon-prev icon-not"></text></view></block><block wx:else><view data-event-opts="{{[['tap',[['handlePrev',['$event']]]]]}}" class="audio-btn-pre" bindtap="__e"><text class="icon icon-prev"></text></view></block><view data-event-opts="{{[['tap',[['handleBtnClick',['$event']]]]]}}" class="audio-btn-play" bindtap="__e"><block wx:if="{{!play}}"><text class="icon icon-player"></text></block><block wx:else><text class="icon icon-zanting"></text></block></view><block wx:if="{{audioIndex==audioSize-1}}"><view class="audio-btn-next"><text class="icon icon-next icon-not"></text></view></block><block wx:else><view data-event-opts="{{[['tap',[['handleNext',['$event']]]]]}}" class="audio-btn-next" bindtap="__e"><text class="icon icon-next"></text></view></block></view><view data-event-opts="{{[['tap',[['handleForward',[15]]]]]}}" class="add-time" bindtap="__e"><text class="icon icon-goforward"></text></view></view></view></view>